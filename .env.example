# Current local PHP runtime (optional absolute paths; put in ignored .env.local).
# PHP_BIN=C:/path/to/php.exe
# PHPRC=C:/path/to/php-configuration-directory
# REG.RU uses private admin-config.php, NOT this .env file.
# Below: legacy Node runtime / one-time migration only; never commit secrets.
NODE_ENV=production
PUBLIC_ORIGIN=https://vosem-utra.ru
# Generate a private key: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# AUTH_ENCRYPTION_KEY=
# One-time bootstrap for a NEW server without an existing account. Use a unique 8+ character password; TOTP enrollment is required.
ADMIN_USERNAME=v.utra@yandex.ru
# ADMIN_PASSWORD=
# Sign in at /admin.html, scan the QR in Yandex ID (Key), and confirm its code there.
# After enrollment the saved account takes precedence; remove ADMIN_PASSWORD from this file.
# Verification tokens from webmaster dashboards (optional; no passwords).
# GOOGLE_SITE_VERIFICATION=
# YANDEX_VERIFICATION=
HOST=127.0.0.1
PORT=3000
