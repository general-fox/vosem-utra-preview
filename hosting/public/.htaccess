Options -Indexes
DirectoryIndex app.php

# HTTPS and canonical host redirects belong to the REG.RU hosting panel.
# PHP receives HTTPS from the web server; client forwarded headers are not trusted.
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^\.well-known/acme-challenge/ - [L]
RewriteRule (^|/)\. - [F,L]
RewriteRule (^|/)(vosem-utra-private|admin-data|orders?-data|node_modules|hosting-tools|server)(/|$) - [F,L,NC]
RewriteRule ^(?:site-build\.json|composer\.(?:json|lock)|package(?:-lock)?\.json)$ - [F,L,NC]

# Live HTML and menu always reach the controller, even if an old static copy remains.
RewriteRule ^(?:index\.html|admin/?|admin\.html|registration\.html|privacy\.html|consent\.html|checkout\.html|order-terms\.html|robots\.txt|sitemap\.xml)$ app.php [END]
RewriteRule ^(?:api/(?:admin(?:/.*)?|menu|ordering|orders(?:/.*)?)|uploads(?:/.*)?|data/menu\.json)$ app.php [END]
# Keep the existing, independently secured loyalty registration handler intact.
RewriteRule ^api/register\.php$ - [END]
RewriteRule ^api/.*\.php$ - [F,L,NC]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ app.php [END]
</IfModule>

<FilesMatch "(?i)(^\.|\.(zip|cafebackup|log|bak|sql|sqlite|sqlite3|db|env|ini|key|md|map)(?:-wal|-shm|-journal)?$)">
Require all denied
</FilesMatch>
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "DENY"
<FilesMatch "\.(html|js|css)$">
Header set Cache-Control "no-cache"
</FilesMatch>
</IfModule>
